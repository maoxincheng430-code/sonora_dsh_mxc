{
  "name": "sonora-music-particles",
  "version": "1.0.0",
  "description": "SONORA 声境 — 本地音乐驱动的 3D 粒子可视化播放器：Three.js 实时粒子、Web Audio 频谱分析、动态歌词与番茄钟",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "electron/main.cjs",
  "keywords": [
    "threejs",
    "music-visualizer",
    "web-audio",
    "particle-system",
    "glsl",
    "audio-reactive",
    "lyrics",
    "lrc",
    "electron",
    "vite",
    "pomodoro"
  ],
  "homepage": "https://github.com/maoxincheng430-code/sonora_dsh_mxc#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/maoxincheng430-code/sonora_dsh_mxc.git"
  },
  "bugs": {
    "url": "https://github.com/maoxincheng430-code/sonora_dsh_mxc/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "desktop": "node scripts/build.mjs && node scripts/electron-launch.mjs",
    "desktop:dev": "cross-env ELECTRON_DEV=true node scripts/electron-launch.mjs",
    "desktop:setup": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ node node_modules/electron/install.js",
    "db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-setup.ps1",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-start.ps1",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-stop.ps1",
    "server": "node server/index.js",
    "lyrics:auto": "node scripts/auto-lyrics.mjs",
    "qq:setup": "npm --prefix tools/qq-api install",
    "netease:setup": "npm --prefix tools/netease install"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "cross-env": "^7.0.3",
    "electron": "^38.2.0",
    "vite": "^7.1.0"
  }
}
