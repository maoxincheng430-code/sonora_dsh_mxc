# 统一换行符，避免不同平台检出后行为不一致。

# Windows 批处理脚本必须是 CRLF，否则 cmd.exe 解析出错
*.cmd text eol=crlf
*.bat text eol=crlf

# PowerShell 脚本也用 CRLF，兼容性最好
*.ps1 text eol=crlf

# 其它文本文件统一 LF
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.wav binary
*.ogg binary
*.m4a binary
*.mp4 binary
*.webm binary
*.zip binary
*.pdf binary